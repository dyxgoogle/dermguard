# ============================================================================
# DermGuard Environment Configuration Template
# Copy this file to `.env` for local development. NEVER commit real secrets.
# ============================================================================

# --- Option A: Google AI Studio (Local Prototyping) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_api_key_here

# --- Option B: Google Cloud / Vertex AI (Production / Cloud Run) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Optional: Google Cloud Secret Manager Injection ---
# When GOOGLE_API_KEY_SECRET_ID is set alongside GOOGLE_CLOUD_PROJECT,
# DermGuard fetches the API key securely from Secret Manager at startup.
# GOOGLE_API_KEY_SECRET_ID=dermguard-google-api-key

# --- Model Routing Configuration ---
DERMGUARD_PRIMARY_MODEL=gemini-2.5-flash
DERMGUARD_PLANNER_MODEL=gemini-2.5-pro
DERMGUARD_SUMMARIZER_MODEL=gemini-2.5-flash-lite

# --- Persistent Session & Memory Storage ---
DERMGUARD_SESSION_DB_URL=sqlite+aiosqlite:///./data/dermguard_sessions.db
DERMGUARD_SENSITIVITY_FILE=data/user_sensitivities.json

# --- Observability, Tracing & Privacy ---
DERMGUARD_LOG_LEVEL=INFO
OTEL_SERVICE_NAME=dermguard-agent
OTEL_SDK_DISABLED=false
# Set to `google_cloud_trace` in Cloud Run / Vertex AI to export spans to Cloud Trace
OTEL_TRACES_EXPORTER=memory
ENABLE_CLOUD_DLP=false
